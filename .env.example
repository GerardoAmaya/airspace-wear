# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Token personal de la API de Sketchfab (Settings > Password & API).
# Lo usa `pnpm models:download` para bajar los modelos 3D.
SKETCHFAB_TOKEN=

# ---------- Avatar del Hangar 360° (scripts/avatar) ----------
# Token de lectura y escritura de un Blob store público de Vercel
# (Storage > Blob > tu store > .env.local). Lo usa `pnpm avatar:upload` para
# publicar el avatar, que no se versiona por la licencia de Mixamo.
BLOB_READ_WRITE_TOKEN=
# Ruta del ejecutable de Blender para `pnpm avatar:build`. Opcional: por
# defecto se busca `blender` en el PATH y /Applications/Blender.app.
# BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender

# ---------- API (apps/api) ----------
# En desarrollo todas son opcionales: sin ellas se usan los valores de abajo.

# Conexión a Postgres. Por defecto, la base local de docker-compose.yml
# (pnpm db:up). En producción es obligatoria.
# DATABASE_URL=postgresql://airspace:airspace@127.0.0.1:5434/airspace

# Base de las pruebas de integración (pnpm test:e2e). Solo se acepta una
# base llamada airspace_test; la de desarrollo nunca se toca.
# DATABASE_URL_TEST=postgresql://airspace:airspace@127.0.0.1:5434/airspace_test

# Puerto y dirección de la API, y orígenes de la web permitidos por CORS
# (separados por coma). Dentro de un contenedor, API_HOST=0.0.0.0.
# API_PORT=4000
# API_HOST=127.0.0.1
# WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ---------- Estilista IA (apps/api) ----------
# Clave de la API de Anthropic (console.anthropic.com). Sin ella el estilista
# queda apagado y la web responde con el guion de demostración.
ANTHROPIC_API_KEY=
# Apagado manual aunque haya clave (true / false).
# STYLIST_ENABLED=true
# Modelo (si se cambia, ajustar los precios en apps/api/src/stylist/usage.ts).
# STYLIST_MODEL=claude-opus-5-5
# Presupuesto diario en dólares: al llegar, el estilista pasa al guion hasta el día siguiente (UTC).
# STYLIST_DAILY_BUDGET_USD=2

# Detrás de un proxy (Railway, balanceador): saltos de confianza, para que el
# límite de peticiones use la IP real del visitante. 0 = sin proxy.
# TRUST_PROXY=0

# Clave compartida entre el servidor de la web y la API (cabecera
# x-internal-key): la web la envía y la API no le aplica el límite de
# peticiones. Mínimo 24 caracteres; la misma en ambos lados. En desarrollo no
# hace falta (la API no limita a 127.0.0.1). Generar con: openssl rand -hex 24
# INTERNAL_API_KEY=

# ---------- Web (apps/web) ----------
# Dirección de la API que usa el servidor de Next.
# API_URL=http://127.0.0.1:4000
# Dirección de la API para el navegador: solo la usa el estilista (streaming).
# Next solo expone variables NEXT_PUBLIC_*; nunca pongas secretos ahí.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Avatar del Hangar 360° (GLB con animaciones, versión completa y liviana).
# No se versiona (licencia de Mixamo): en producción vive en Vercel Blob
# (pnpm avatar:upload imprime las URLs). En desarrollo, sin estas variables se
# usa la copia local: copia assets/avatar/out/avatar.glb y avatar-lite.glb a
# apps/web/public/avatar-local/ (carpeta ignorada por git).
# NEXT_PUBLIC_AVATAR_URL=/avatar-local/avatar.glb
# NEXT_PUBLIC_AVATAR_LITE_URL=/avatar-local/avatar-lite.glb

# Vestuario del maniquí (prendas generadas por pnpm avatar:build, aparte del
# avatar). En producción se sube con pnpm avatar:upload, que imprime las URLs
# con el hash en el nombre. Sin NEXT_PUBLIC_OUTFIT_URL en producción, el Hangar
# muestra el maniquí sin ropa y sin el panel de vestuario. Sin la versión
# liviana se usa la completa. En desarrollo, sin estas variables se usa la
# copia local (outfit.glb y outfit-lite.glb en apps/web/public/avatar-local/).
# NEXT_PUBLIC_OUTFIT_URL=/avatar-local/outfit.glb
# NEXT_PUBLIC_OUTFIT_LITE_URL=/avatar-local/outfit-lite.glb

# Dirección pública del sitio (sin barra final). Next la usa para las URLs
# absolutas de los metadatos: hreflang y canónica. Se lee al hacer el build.
# SITE_URL=http://localhost:3000

# Clave para POST /api/revalidate (refresca la caché del catálogo; la usa
# pnpm db:seed). Obligatoria en producción; en desarrollo puede quedar vacía.
# REVALIDATE_SECRET=

# ---------- Docker (perfil full de docker-compose.yml) ----------
# Las imágenes nunca guardan secretos: al ejecutar, compose pasa a los
# contenedores ANTHROPIC_API_KEY, STYLIST_*, TRUST_PROXY y REVALIDATE_SECRET
# de este archivo. DATABASE_URL, API_URL y WEB_ORIGIN los fija compose.

# API que usa `next build` dentro de la imagen de la web para prerenderizar el
# catálogo. Por defecto, la API del perfil full publicada en el host.
# WEB_BUILD_API_URL=http://host.docker.internal:4001

# Solo para el build de la imagen de la web (ya la fija apps/web/Dockerfile):
# con 1, Next genera la salida standalone. No hace falta ponerla aquí.
# BUILD_STANDALONE=1
