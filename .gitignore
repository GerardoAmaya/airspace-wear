# Secretos: nunca se versionan (la plantilla .env.example sí)
.env
.env.*
!.env.example

# Dependencias
node_modules/

# Modelos 3D originales: pesados, se regeneran con `pnpm models:download`
/assets/models/raw/

# Avatar de Mixamo: la licencia no permite redistribuir los archivos tal cual
/assets/avatar/raw/
# Avatar convertido y optimizado: se publica en Vercel Blob (pnpm avatar:upload)
/assets/avatar/out/
# Copia local del avatar para pnpm dev (NEXT_PUBLIC_AVATAR_URL la usa por defecto)
/apps/web/public/avatar-local/
# Prendas propias generadas (pnpm garments): geometría, texturas y GLB intermedios
/assets/garments/out/
# Caché de Python de los scripts de Blender
__pycache__/

# Builds, caché y código generado
next-env.d.ts
apps/api/src/generated/
.next/
dist/
out/
build/
coverage/
# Resultados y reportes de Playwright (E2E)
apps/web/e2e/.results/
apps/web/e2e/.report/
.turbo/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Sistema operativo y editores
.DS_Store
.idea/
*.swp

# Ajustes personales de Claude Code (los compartidos viven en .claude/settings.json)
.claude/settings.local.json
