{
  "name": "airspace-wear",
  "version": "0.1.0",
  "private": true,
  "description": "AIRSPACE Wear: multi-brand sneaker and apparel e-commerce. Portfolio project, not affiliated with any brand shown.",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @airspace/contracts build && pnpm --parallel --filter @airspace/contracts --filter @airspace/api --filter @airspace/web dev",
    "dev:web": "pnpm --filter @airspace/web dev",
    "dev:api": "pnpm --filter @airspace/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @airspace/contracts build && pnpm -r typecheck",
    "test": "pnpm --filter @airspace/contracts build && pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @airspace/contracts build && pnpm --filter @airspace/api test:e2e",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "docker:up": "docker compose --profile full up -d --build --wait api && docker compose --profile full up -d --build --no-deps --wait web",
    "docker:down": "docker compose --profile full down",
    "db:migrate": "pnpm --filter @airspace/api db:migrate",
    "db:seed": "pnpm --filter @airspace/api db:seed",
    "models": "pnpm models:download && pnpm models:optimize && pnpm models:credits",
    "models:download": "node --env-file=.env scripts/models/download.mjs",
    "models:optimize": "node scripts/models/optimize.mjs",
    "models:credits": "node scripts/models/credits.mjs",
    "models:posters": "node scripts/models/posters.mjs",
    "models:preview": "node scripts/models/preview.mjs",
    "avatar:build": "node --env-file-if-exists=.env scripts/avatar/build.mjs",
    "avatar:upload": "node --env-file=.env scripts/avatar/upload.mjs",
    "avatar:fit": "node --env-file-if-exists=.env scripts/avatar/fit.mjs",
    "design:preview": "node scripts/design/serve.mjs",
    "fx:smoke": "node scripts/fx/smoke-atlas.mjs"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@vercel/blob": "2.9.0",
    "draco3dgltf": "1.5.9",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.3.0",
    "playwright-core": "1.65.1",
    "sharp": "0.35.5"
  }
}
