{
  "name": "@airspace/web",
  "version": "0.1.0",
  "private": true,
  "description": "Sitio de AIRSPACE Wear (Next.js + React Three Fiber).",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint && node scripts/check-tokens.mjs && node scripts/check-messages.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "e2e": "playwright test",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "lint:messages": "node scripts/check-messages.mjs"
  },
  "dependencies": {
    "@airspace/contracts": "workspace:*",
    "@google/model-viewer": "^4.4.0",
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "gsap": "3.15.1",
    "lenis": "1.3.28",
    "motion": "14.14.0",
    "next": "16.4.6",
    "next-intl": "4.16.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  }
}
