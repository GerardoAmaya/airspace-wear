// Esquema de la base de AIRSPACE Wear (Prisma 7). La URL de conexión vive en
// prisma.config.ts.
//
// Reglas (ver CLAUDE.md y docs/plan-paso-2.md):
// - Nombres y descripciones de productos se guardan por idioma en
//   ProductTranslation (clave: producto + idioma), nunca en los mensajes de la web.
// - Categorías y disponibilidad son códigos; sus etiquetas son texto de UI.
// - Las posiciones de los hotspots están en metros, en el espacio del modelo
//   (pose canónica), así siguen valiendo si el modelo se vuelve a optimizar.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  es
  en
}

enum Category {
  sneaker
  // Tacos de fútbol (botines con tapones).
  cleat
  apparel
  ball
}

// Subcategoría de la ropa (camisetas, sudaderas, chaquetas, pantalones,
// shorts, gorras y accesorios). Solo la ropa la tiene (CHECK en la migración).
enum Subcategory {
  tshirt
  sweatshirt
  jacket
  pants
  shorts
  cap
  accessory
}

// Lugar de una prenda en el avatar del Hangar 360°. Null: solo catálogo.
enum AvatarSlot {
  top
  bottom
  head
  eyes
}

// EU: calzado; ALPHA: tallas de letra (S a XL); ONE: talla única; BALL: balones.
enum SizeSystem {
  EU
  ALPHA
  ONE
  BALL
}

enum Availability {
  new
  available
  low_stock
  coming_soon
}

enum Foot {
  left
  right
}

// Lado externo del zapato respecto de la cámara por defecto (+Z).
enum LateralSide {
  plus_z
  minus_z
}

enum CreditKind {
  model
  font
  library
}

model Brand {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  name     String
  products Product[]
}

model Product {
  id           Int                  @id @default(autoincrement())
  slug         String               @unique
  // Referencia de tienda, por ejemplo "AS-001".
  reference    String               @unique
  category     Category
  // Solo ropa: una subcategoría (obligatoria en la ropa) y, si se puede
  // poner en el avatar, su lugar en él.
  subcategory  Subcategory?
  avatarSlot   AvatarSlot?
  brandId      Int
  brand        Brand                @relation(fields: [brandId], references: [id])
  priceCents   Int
  currency     String               @default("USD") @db.Char(3)
  availability Availability         @default(available)
  // Datos técnicos sin idioma: peso, altura de suela, paneles, año, código de sede.
  attributes   Json                 @default("{}")
  published    Boolean              @default(true)
  sortOrder    Int                  @default(0)
  // Imagen o póster propio (ropa sin modelo 3D, Open Graph). Los productos
  // con 3D usan además el póster del modelo.
  imageUrl     String?
  // Acento del visor (hex): tinta para tema oscuro y para tema claro, AA
  // sobre sus fondos. Null = el lima de la marca.
  accentDark   String?
  accentLight  String?
  // Un modelo puede servir a varios productos (por ejemplo, dos colorways
  // que comparten malla).
  modelId      Int?
  model        Model3D?             @relation(fields: [modelId], references: [id])
  translations ProductTranslation[]
  sizes        ProductSize[]
  hotspots     Hotspot[]
  orderItems   OrderItem[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([published, sortOrder])
  @@index([category, published, sortOrder])
  @@index([category, subcategory, published, sortOrder])
  @@index([brandId])
  @@index([modelId])
}

model ProductTranslation {
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      Locale
  name        String
  colorway    String?
  tagline     String
  description String
  // Edición y sede (balones mundialistas), por ejemplo "Mundial Alemania 2006" y "Berlín".
  edition     String?
  hostCity    String?
  // Materiales por pieza: { upper, sole } en sneakers, { finish } en balones.
  materials   Json     @default("{}")
  tags        String[] @default([])

  @@id([productId, locale])
}

model ProductSize {
  id        Int        @id @default(autoincrement())
  productId Int
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Sistema de tallas: EU en sneakers y tacos, ALPHA (S a XL) u ONE (talla
  // única) en la ropa, BALL en balones (talla 5).
  system    SizeSystem
  label     String
  sortOrder Int        @default(0)
  stock     Int        @default(0)

  @@unique([productId, system, label])
}

model Model3D {
  id                Int          @id @default(autoincrement())
  // Slug del manifest (assets/models/manifest.json).
  slug              String       @unique
  heroUrl           String
  liteUrl           String
  heroBytes         Int
  liteBytes         Int
  heroTriangles     Int
  liteTriangles     Int
  foot              Foot?
  // Eje hacia el que mira el lado externo del zapato, del manifest.
  lateralSideFacing LateralSide?
  // Pósters WebP por tema (pnpm models:posters): la luz cambia con el tema.
  posterDarkUrl     String?
  posterLightUrl    String?
  creditId          Int          @unique
  credit            AssetCredit  @relation(fields: [creditId], references: [id])
  products          Product[]
}

// Los hotspots cuelgan del producto porque su texto describe el producto,
// pero su posición está en el espacio del modelo: si el producto cambia de
// modelo, se recalibran en prisma/seed/hotspots.ts.
model Hotspot {
  id           Int                  @id @default(autoincrement())
  productId    Int
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  key          String
  sortOrder    Int                  @default(0)
  // Punto [x, y, z] en metros, en el espacio del modelo.
  position     Float[]
  // Pose del zapato y encuadre de cámara para este detalle.
  view         Json                 @default("{}")
  translations HotspotTranslation[]

  @@unique([productId, key])
}

model HotspotTranslation {
  hotspotId Int
  hotspot   Hotspot @relation(fields: [hotspotId], references: [id], onDelete: Cascade)
  locale    Locale
  title     String
  text      String

  @@id([hotspotId, locale])
}

// Consumo diario del estilista IA, para el presupuesto (STYLIST_DAILY_BUDGET_USD).
// No guarda conversaciones: solo conteos y costo estimado.
model StylistUsage {
  // Día en UTC, YYYY-MM-DD.
  day              String @id
  requests         Int    @default(0)
  inputTokens      Int    @default(0)
  outputTokens     Int    @default(0)
  cacheReadTokens  Int    @default(0)
  cacheWriteTokens Int    @default(0)
  // Costo estimado en millonésimas de dólar.
  costMicros       Int    @default(0)
}

model AssetCredit {
  id            Int        @id @default(autoincrement())
  // Clave estable, por ejemplo "model:air-jordan-1" o "font:hubot-sans".
  key           String     @unique
  kind          CreditKind
  // Nombre del recurso en el sitio (producto, fuente o librería).
  name          String
  // Título del original y su enlace (modelos).
  sourceTitle   String?
  sourceUrl     String?
  author        String
  authorUrl     String?
  licenseName   String
  licenseUrl    String?
  commercialUse Boolean    @default(true)
  shareAlike    Boolean    @default(false)
  // Códigos de cambios (los traduce la web): kept_one_shoe, reoriented_rescaled...
  changes       String[]   @default([])
  sortOrder     Int        @default(0)
  model3d       Model3D?
}

// ---------- Cuentas (Better Auth, apps/web/lib/auth) ----------
// Tablas del esquema base de Better Auth (user, session, account,
// verification) con sus nombres y columnas tal cual: Better Auth las lee y
// escribe desde la web con su propio adaptador de Postgres, y la API solo lee
// User y Session para saber quién hace la petición (src/auth). Los ids son
// texto que genera Better Auth. Las fechas van con zona horaria (timestamptz,
// como la migración propia de Better Auth): así la web y la API leen la misma
// hora aunque cada proceso corra en otra zona. Los pedidos (paso 5, fase 2)
// apuntarán a User.id.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  // Foto de perfil de Google (URL), si la hay.
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  orders        Order[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  // Token opaco que viaja firmado en la cookie de sesión. La web lo reenvía a
  // la API (Authorization: Bearer) para identificar al usuario.
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// Cuenta enlazada de un proveedor (Google): providerId "google" y accountId
// el id de Google del usuario.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  // Solo para correo y contraseña; aquí no se usa (solo Google).
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

// Valores temporales de Better Auth (por ejemplo, el estado del flujo OAuth).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

// ---------- Pedidos y pago de prueba (paso 5, fases 2 y 3) ----------
// Un pedido nace "pending" al crear la sesión de Stripe Checkout y pasa a
// "paid" cuando Stripe confirma el pago (webhook o verificación al abrir el
// pedido); "expired" si la sesión de pago venció sin pagarse. Los precios y
// nombres se copian del catálogo del servidor al crear el pedido (nunca del
// navegador), así el pedido no cambia si el catálogo cambia después.

enum OrderStatus {
  pending
  paid
  expired
}

model Order {
  // UUID: va en la URL del pedido y no deja adivinar otros.
  id                      String      @id @default(uuid()) @db.Uuid
  // Correlativo del número visible: AS-<año de creación>-<seq con 6 dígitos>.
  seq                     Int         @unique @default(autoincrement())
  userId                  String
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                  OrderStatus @default(pending)
  currency                String      @default("USD") @db.Char(3)
  subtotalCents           Int
  // Hoy igual al subtotal (envío gratis, sin impuestos en el modo de prueba).
  totalCents              Int
  // Idioma en que se hizo la compra (Stripe Checkout y textos del pedido).
  locale                  Locale
  stripeCheckoutSessionId String?     @unique
  paidAt                  DateTime?   @db.Timestamptz(3)
  // Número de guía ficticio, asignado al confirmarse el pago.
  trackingNumber          String?     @unique
  createdAt               DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  items                   OrderItem[]

  @@index([userId, createdAt])
}

model OrderItem {
  id             Int      @id @default(autoincrement())
  orderId        String   @db.Uuid
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // El producto puede despublicarse o borrarse después: el pedido conserva
  // su copia (slug, nombres, precio e imagen).
  productId      Int?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  slug           String
  brand          String
  // Nombre y detalle (colorway o edición) en ambos idiomas, copiados al comprar.
  nameEs         String
  nameEn         String
  detailEs       String?
  detailEn       String?
  // Talla elegida (etiqueta del catálogo); null en talla única.
  size           String?
  unitPriceCents Int
  quantity       Int
  // Póster por tema (o la imagen propia del producto), si lo hay.
  imageDarkUrl   String?
  imageLightUrl  String?
  sortOrder      Int      @default(0)

  @@index([orderId])
  @@index([productId])
}
